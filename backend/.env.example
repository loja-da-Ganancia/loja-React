# Renomeie este arquivo para .env e preencha os valores

# String de conexão do MongoDB Atlas (ou local)
# Exemplo Atlas: mongodb+srv://usuario:senha@cluster.mongodb.net/greedstore?retryWrites=true&w=majority
# Exemplo local: mongodb://localhost:27017/greedstore
MONGO_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/greedstore?retryWrites=true&w=majority

# Chave secreta para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Porta do servidor (opcional, padrão: 5000)
PORT=5000
